{
  "name": "agentkit-keeperhub",
  "version": "0.1.0",
  "description": "KeeperHub action provider for Coinbase AgentKit: simulate-gated onchain execution with idempotent retries and chain-verified receipts an agent can query after a failure.",
  "keywords": [
    "coinbase",
    "agentkit",
    "action-provider",
    "keeperhub",
    "onchain",
    "idempotency",
    "reconciliation",
    "ai-agent"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "npm run build && vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@coinbase/agentkit": ">=0.9.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@coinbase/agentkit": "^0.9.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20"
  }
}